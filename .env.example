# ─── ATLAS Environment Configuration ────────────────────────────────────
# Salin file ini ke .env dan isi konfigurasi yang diperlukan.
# cp .env.example .env

# OpenAI / OpenRouter API Key (wajib untuk fitur AI/chat)
# Daftar di https://openrouter.ai/keys untuk mendapatkan key gratis
OPENROUTER_API_KEY=

# Google AI (Gemini) API Key — alternatif OpenRouter; mendukung chat DAN
# embedding (dibutuhkan untuk semantic search vektor). Free tier tersedia:
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Model AI yang digunakan (default per provider: gemini-2.5-flash untuk
# google, openrouter/free untuk openrouter)
# AI_MODEL=gemini-2.5-flash
# EMBEDDING_MODEL=gemini-embedding-001

# Port server backend (default: 3000)
# PORT=3000

# Path database SQLite (default: ./data/atlas.db)
# DATABASE_PATH=./data/atlas.db

# ─── Indexing Configuration ─────────────────────────────────────────────
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# MAX_FILE_SIZE=52428800
# MAX_CONCURRENT_PROCESSING=3
# ENABLE_OCR=false

# ─── AI Provider Configuration ─────────────────────────────────────────
# AI_PROVIDER=openrouter
# EMBEDDING_MODEL=openai/text-embedding-ada-002

# ─── CORS / Security ────────────────────────────────────────────────────
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# NODE_ENV=development