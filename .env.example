# ─── ATLAS Environment Configuration ────────────────────────────────────
# Salin file ini ke .env lalu isi sesuai kebutuhan:
#   cp .env.example .env
#
# Catatan: konfigurasi AI (provider, API key, model) yang disimpan lewat
# halaman Settings (tabel app_settings) selalu MENGATASI nilai di file ini.

# ─── AI Provider ─────────────────────────────────────────────────────────
# Provider default: "google" (Gemini) — mendukung chat DAN embedding
# (embedding dibutuhkan untuk semantic search vektor). Free tier tersedia:
#   https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# AI_PROVIDER=google
# AI_MODEL=gemini-3.6-flash
# EMBEDDING_MODEL=gemini-embedding-001

# Alternatif: OpenRouter (chat saja; katalognya belum menyediakan model
# embedding, jadi semantic search butuh provider Google).
#   https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# AI_PROVIDER=openrouter

# ─── Server ──────────────────────────────────────────────────────────────
# Port server backend (default: 3000)
# PORT=3001

# Path database SQLite (default: ./data/atlas.db)
# DATABASE_PATH=./data/atlas.db

# ─── Indexing ────────────────────────────────────────────────────────────
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# MAX_FILE_SIZE=52428800
# MAX_CONCURRENT_PROCESSING=4
# ENABLE_OCR=false

# ─── CORS / Security ─────────────────────────────────────────────────────
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# NODE_ENV=development
